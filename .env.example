# Copy to .env.local (gitignored) and fill in only what you need. Nothing here is required to run
# the tests, the keyless bench, `pnpm build:contracts` or the read-only app.
# `pnpm demo:setup` writes apps/web/.env.local itself, copying the keys below into it.

# NEAR AI Cloud (https://cloud.near.ai): the private screen in an enclave. Without it the testnet
# demo signs verdicts with a labelled local test key, and "Write your own email" is off.
NEARAI_API_KEY=
# Optional: another enclave-hosted model. Default: Qwen/Qwen3-VL-30B-A3B-Instruct.
NEARAI_MODEL=

# NEAR Intents Agent API (partner key from the API's partner portal): the "Pay from: Agent API" path.
# Then run `node scripts/agentapi-setup.ts`.
NEAR_INTENTS_AGENT_API_URL=https://api.agentsonintents.com
NEAR_INTENTS_AGENT_API_KEY=

# NEAR Intents 1Click: optional, lowers 1Click's fee. Shield: optional, holds a cross-chain payout
# while a NEAR Intents Shield incident touches its route.
ONECLICK_JWT=
SHIELD_JWT=

# Mainnet scripts only (scripts/mainnet-*.ts). Use a dedicated account.
MAINNET_ROOT_ID=
MAINNET_ROOT_KEY=
# The Base address that receives the supplier payout, and the one you fund the vault from.
MAINNET_SUPPLIER_BASE=
MAINNET_FUNDER_BASE=
# Optional: an account the mainnet scripts must refuse to use (for example, where a prize is paid).
MAINNET_PROTECTED_ACCOUNT=

# Optional: a real inbox for the sandbox's agent on AgentMail (https://agentmail.to, free plan).
# Create an inbox and a webhook for message.received and message.received.unauthenticated that
# points at <your site>/api/inbox/email; the webhook's secret starts with whsec_. Mail to the inbox
# reaches the same agent as "Write your own email", and the agent replies with Veto's decision.
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
# The inbox's address, also shown in the app. Default: veto-agent@agentmail.to.
AGENTMAIL_INBOX=
NEXT_PUBLIC_AGENT_EMAIL=
